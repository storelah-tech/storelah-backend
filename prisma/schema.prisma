// StoreLah — Operator CMS data model.
// Extracted from the original dashboard prototype (storelah-cms/dashboard.html).
// UI constraint: the dashboard layout/CSS is frozen — only data bindings may be added.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  VIEWER
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum UnitStatus {
  OCCUPIED
  AVAILABLE
  RESERVED
  OVERDUE
  MAINTENANCE
  INACTIVE
}

enum TenantStatus {
  ACTIVE
  DUE_SOON
  OVERDUE
  NOTICE
  INACTIVE
}

enum AccountType {
  PERSONAL
  BUSINESS
  // Auto-provisioned during unauthenticated (guest) booking checkout.
  // Guests hold a bcrypt-hashed default password (STORELAH_GUEST_DEFAULT_PASSWORD)
  // until they register or log in with a real credential.
  GUEST
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  ACTIVE
  CANCELLED
}

enum InvoiceStatus {
  PAID
  DUE
  OVERDUE
}

enum LeadStage {
  NEW_ENQUIRY
  CONTACTED
  VIEWING_BOOKED
  PROPOSAL_SENT
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  REFERRAL
  GOOGLE
}

enum AppointmentType {
  VIEWING
  CALLBACK
  VIDEO_CONSULT
  MOVE_IN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  DONE
  CANCELLED
}

enum ConversationChannel {
  WHATSAPP
  EMAIL
  PHONE
  IN_PERSON
  WEBSITE
}

enum MessageDirection {
  IN
  OUT
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(MANAGER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id               String      @id @default(cuid())
  email            String      @unique
  name             String
  mobile           String?
  passwordHash     String
  type             AccountType @default(PERSONAL)
  companyName      String?
  uen              String?
  resetToken       String?     @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Branch {
  id              String       @id @default(cuid())
  code            String       @unique // BM / WD / UB
  name            String
  address         String
  description     String?
  operatingHours  String
  status          BranchStatus @default(ACTIVE)
  floors          Floor[]
  units           Unit[]
  tenants         Tenant[]
  leads           Lead[]
  appointments    Appointment[]
  safeguardRules  SafeguardRule[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Floor {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  level     Int // 1..4
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units      Unit[]
  floorPlan  FloorPlan? // one-to-one: a floor has exactly one plan (see FloorPlan)

  @@unique([branchId, level])
}

// Floor plan for a facility's floor — the editable canvas the operator draws in
// the CMS "facility setup" view.
//
// BLUEPRINT SCALE: 1 grid unit = 1 FOOT. Canvas `width`/`height` are the
// building's real dimensions in feet, and every placement/block rect (x/y/
// width/height) is an integer foot rect in the same space. Columns stay `Int`
// (1 grid unit maps 1:1 to 1 ft — no fractional feet); the editor snaps to the
// grid and renderers scale ft→px at any zoom.
//
// Free-form decoration (walls / corridors / entrance / lift / stairs / fire
// exit) lives in `structure`, plus unit placements.
//
// SINGLE plan per floor, enforced by `@@unique([floorId])`: a floor has one
// physical layout, so consumers can always read THE plan for a floor without
// resolving versions/activation. If draft/versioning is ever needed it can be
// added additively (e.g. a `status` column).
//
// `structure` is a JSONB document rather than relational rows because the
// decorations are presentational and heterogeneously shaped (walls, rooms,
// corridors, entrance, lift, stairs, fire exit each carry different fields),
// are only ever consumed as a whole by the renderer, and are never queried or
// filtered individually. Postgres validates JSON at write time.
//
// Deleting a plan cascades to its placements (UnitPlacement) — see that model —
// and never touches Unit rows.
model FloorPlan {
  id        String   @id @default(cuid())
  floorId   String   @unique
  floor     Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  width     Int      @default(0) // canvas width in FEET (1 grid unit = 1 ft)
  height    Int      @default(0) // canvas height in FEET (1 grid unit = 1 ft)
  structure Json? // LEGACY free-form decorations (walls / corridors / entrance /
                  // lift / stairs / fire exit) from before FloorPlanBlock existed.
                  // Kept readable/writable for old clients; the editor authors new
                  // decorations as FloorPlanBlock rows instead (see FloorPlanBlock).
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  placements UnitPlacement[]
  blocks     FloorPlanBlock[]
}

// Operator-authored layout-decoration rectangles on a plan canvas — e.g. lift,
// stairs, exits, "walking area". A block is a uniform primitive: a NAME label +
// a grid-unit rect (x/y top-left, width/height bounding box, same coordinate
// space as UnitPlacement). It has NO business behaviour — it is purely drawn by
// the renderer. Blocks are the replacement for the old `structure` JSON
// decorations: unlike the heterogeneously-shaped walls/corridors markers, every
// block is the same shape (name + rect), so a flat relational table is clean,
// consistent with UnitPlacement, and each block is addressable/editable/deletable
// on its own (drag, resize, rename) — the JSON polymorphism argument that applied
// to `structure` does not apply here.
//
// Delete semantics: deleting a FloorPlan cascades its blocks (geometry is
// subordinate to the plan).
model FloorPlanBlock {
  id          String    @id @default(cuid())
  floorPlanId String
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  name        String // operator-given label ("Lift", "Stair", "Walking area", "Exit", ...)
  x           Int // top-left FEET coordinate on the plan canvas (1 grid unit = 1 ft)
  y           Int
  width       Int // rendered bounding box in FEET (drag / resize)
  height      Int
  color       String? // optional render tint (hex); renderers default to a neutral tone when null
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([floorPlanId])
}

model UnitSize {
  id        String   @id @default(cuid())
  code      String   @unique // LOCKER / SMALL / MEDIUM / LARGE
  name      String // Locker / Small / Medium / Large
  sqftFrom  Int
  sqftTo    Int
  // Blueprint footprint of a unit of this size, in FEET (1 grid unit = 1 ft).
  // Nullable so a size added without dims falls back to the documented aspect
  // formula in src/core/floorPlans.ts (sqftFootprint); see docs/FLOOR_PLAN_MODEL.md.
  widthFt   Int?
  heightFt  Int?
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units      Unit[]
  promotions Promotion[]
  safeguardRules SafeguardRule[]

  @@map("UnitSize")
}

model Unit {
  id             String     @id @default(cuid())
  branchId       String
  branch         Branch     @relation(fields: [branchId], references: [id])
  floorId        String
  floor          Floor      @relation(fields: [floorId], references: [id])
  sizeId         String
  size           UnitSize   @relation(fields: [sizeId], references: [id])
  unitCode       String     @unique // e.g. BM-01-01
  name           String? // optional display label; null/empty => display name falls back to unitCode
  sqft           Int
  monthlyRate    Decimal    @default(0) @db.Decimal(10, 2)
  status         UnitStatus @default(AVAILABLE)
  climateControl String? // e.g. "Ambient climate"
  deletedAt      DateTime? // soft-delete lifecycle marker: null = active; set = hidden from all reads
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant         Tenant?       @relation("CurrentTenant")
  rateHistory    RateChange[]
  bookings       Booking[]
  invoices       Invoice[]
  notices        Notice[]
  placement      UnitPlacement? // one-to-one: a unit appears on its floor's plan at most once

  @@unique([branchId, unitCode])
  @@index([branchId, floorId])
  @@index([status])
}

// Per-unit placement on a floor plan: where (x, y) and how big (width, height) a
// unit is drawn/sized on its floor's plan canvas, in FEET (1 grid unit = 1 ft —
// the rect's area in square grid units ≈ the unit's sqft; see
// docs/FLOOR_PLAN_MODEL.md and sqftFootprint() in src/core/floorPlans.ts).
// Kept as a SEPARATE join model
// rather than geometry columns on Unit so the Unit row stays clean (units predate
// floor plans; geometry is meaningless without a plan) and a soft-deleted unit's
// placement survives deletion (Unit.deletedAt is an UPDATE, not a DELETE).
//
// `@@unique([unitId])` — a unit is placed exactly once: it belongs to one floor,
// and a floor has one plan. The unique key doubles as the upsert key for the
// editor's save. `@@index([floorPlanId])` serves plan-scoped reads.
//
// Delete semantics (respecting the soft-delete lifecycle):
//   - deleting a FloorPlan cascades its placements (geometry is subordinate to the
//     plan; Units are untouched — the FK points from placement to unit, never back);
//   - `onDelete: Restrict` on unit guards against a future HARD unit delete while a
//     placement exists (the purge path must clear placements first; today the app
//     only soft-deletes via `deletedAt`, so Restrict never fires);
//   - reads render a plan by joining placement → unit and FILTERING OUT placements
//     whose unit has `deletedAt != null`, so stale geometry never surfaces.
model UnitPlacement {
  id          String    @id @default(cuid())
  floorPlanId String
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  unitId      String    @unique
  unit        Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  x           Int // top-left FEET coordinate on the plan canvas
  y           Int
  width       Int // rendered bounding box in FEET (drag / resize)
  height      Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([floorPlanId])
}

model Tenant {
  id             String      @id @default(cuid())
  name           String
  type           AccountType @default(PERSONAL)
  segment        String? // E-commerce / Renovation / Downsizing / ...
  email          String?
  mobile         String?
  unitId         String?     @unique
  unit           Unit?       @relation("CurrentTenant", fields: [unitId], references: [id])
  moveInDate     DateTime?
  monthlyRate    Decimal     @db.Decimal(10, 2)
  psf            Decimal     @db.Decimal(10, 2)
  nextPayment    DateTime?
  status         TenantStatus
  lastAccessAt   DateTime?
  accessMethod   String?
  autoDebit      Boolean     @default(false)
  missedPayments Int         @default(0)
  paymentCount   Int         @default(0)
  lifetimeValue  Decimal     @default(0) @db.Decimal(12, 2)
  branchId       String?
  branch         Branch?     @relation(fields: [branchId], references: [id])

  bookings  Booking[]
  invoices  Invoice[]
  notices   Notice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Customer-submitted move-out notice (POST /api/v1/customer/notice). One row
// per submission — resubmitting supersedes (the portal reads the LATEST by
// createdAt); history is preserved for the operator. No workflow state machine
// exists yet: presence of a row == the notice was submitted; TenantStatus.NOTICE
// remains an operator-managed CMS status and is intentionally NOT auto-flipped.
model Notice {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  lastDay   DateTime // the customer-declared final day of tenancy
  createdAt DateTime @default(now()) // submission time
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Booking {
  id             String        @id @default(cuid())
  bookingRef     String        @unique // e.g. SL-2026-0912
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  unitId         String
  unit           Unit          @relation(fields: [unitId], references: [id])
  moveInDate     DateTime
  duration       String // "Monthly" | "3 months" | ...
  amount         Decimal       @db.Decimal(10, 2)
  status         BookingStatus @default(PENDING_PAYMENT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Invoice {
  id         String        @id @default(cuid())
  invoiceNo  String        @unique // e.g. INV-2026-0847
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  unitId     String
  unit       Unit          @relation(fields: [unitId], references: [id])
  amount     Decimal       @db.Decimal(10, 2)
  dueDate    DateTime
  status     InvoiceStatus @default(DUE)
  method     String? // Auto-debit / Card / Manual
  billedMonth DateTime @default(now())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
}

model Lead {
  id            String     @id @default(cuid())
  name          String
  type          AccountType @default(PERSONAL)
  segment       String? // Reno / Home / SME / Expat
  stage         LeadStage  @default(NEW_ENQUIRY)
  source        LeadSource @default(WEBSITE)
  preferredSize String?
  preferredBranchId String?
  branch        Branch?    @relation(fields: [preferredBranchId], references: [id])
  monthlyRate   Decimal?   @db.Decimal(10, 2)
  note          String?
  email         String?
  mobile        String?
  owner         String? // operator handling this lead (shown as "owner" in the lead database)
  nextActionAt  DateTime? // next follow-up ("next step" column in the lead database)
  // Loss attribution for the analytics page: set when a lead moves to LOST.
  // lossReason defaults to "Unspecified" so pre-existing flows keep working;
  // lossValue defaults to the lead's monthlyRate at loss time (revenue proxy).
  lossReason    String?
  lossValue     Decimal?  @db.Decimal(10, 2)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  appointments Appointment[]
  conversations Conversation[]
}

model Appointment {
  id         String            @id @default(cuid())
  title      String
  personName String
  type       AppointmentType
  branchId   String?
  branch     Branch?           @relation(fields: [branchId], references: [id])
  leadId     String?
  lead       Lead?             @relation(fields: [leadId], references: [id])
  startAt    DateTime
  endAt      DateTime?
  status     AppointmentStatus @default(PENDING)
  note       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([startAt])
  @@index([branchId])
  @@index([leadId])
}

// Operator inbox threads. One lead may have several conversations (e.g. a
// WhatsApp thread plus an email thread); `externalId` holds the provider-side
// thread id when one exists. Real WhatsApp/email SENDING is out of scope —
// outbound rows are recorded by the send stub in src/core/conversations.ts.
model Conversation {
  id         String              @id @default(cuid())
  leadId     String
  lead       Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel    ConversationChannel @default(WHATSAPP)
  externalId String?
  assignee   String? // operator owner of this thread (inbox "Assign")
  status     String              @default("OPEN") // OPEN | CLOSED
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  messages Message[]
  notes    ConversationNote[]

  @@index([leadId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection @default(IN)
  sender         String? // display name of the author (lead name / operator)
  body           String
  sentAt         DateTime         @default(now())
  createdAt      DateTime         @default(now())

  @@index([conversationId])
}

// Internal operator notes on a thread (inbox composer "Add a note") — never
// sent anywhere, only shown in the timeline.
model ConversationNote {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  body           String
  author         String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model RateChange {
  id         String   @id @default(cuid())
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id])
  date       DateTime
  previous   Decimal  @db.Decimal(10, 2)
  current    Decimal  @db.Decimal(10, 2)
  changePct  Decimal  @db.Decimal(6, 2)
  reason     String
  appliedBy  String // name or "System"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([unitId])
}

enum PromotionDiscountType {
  PERCENTAGE
  FLAT
}

enum PromotionBenefitType {
  PERCENTAGE
  DOLLAR
  FREE_MONTHS
  CREDITS
}

enum PlanKind {
  DISCOUNT_MATRIX
  FREE_MONTHS
  PROMO_CODE
  CREDITS
}

enum PlanStatus {
  DRAFT
  VALIDATED
  SCHEDULED
  ACTIVE
  ENDED
}

enum PromoStatus {
  DRAFT
  ACTIVE
  SCHEDULED
  ENDED
  USED
}

model Promotion {
  id             String                 @id @default(cuid())
  code           String                 @unique // e.g. STORELAH10
  name           String
  description    String?
  discountType   PromotionDiscountType  @default(PERCENTAGE)
  discountValue  Decimal                @db.Decimal(10, 2)
  minMonths      Int?
  applicableSizeId String?
  applicableSize UnitSize?              @relation(fields: [applicableSizeId], references: [id])
  startDate      DateTime?
  endDate        DateTime?
  active         Boolean                @default(true)

  // Enhanced fields (additive — backward compatible)
  planId         String?                // FK → PromotionPlan (nullable for backward compat)
  plan           PromotionPlan?         @relation(fields: [planId], references: [id])
  status         PromoStatus?           @default(DRAFT)
  benefitType    PromotionBenefitType?
  applyTo        String?                // "First invoice only" / "First 3 invoices" / "Every invoice" / "Selected months"
  usagePerCustomer Int?
  redemptionCap  Int?
  perUnitApplication Boolean?
  stackingRule   String?                // "Cannot combine" / "Can combine selected" / "Can combine with credits"
  budgetCap      Decimal?               @db.Decimal(12, 2)

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([active])
  @@index([planId])
}

model PromotionPlan {
  id              String       @id @default(cuid())
  kind            PlanKind
  name            String
  code            String?      @unique // customer-facing code (only for PROMO_CODE kind)
  status          PlanStatus   @default(DRAFT)
  description     String?
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  facilityScope   Json         @default("[\"ALL\"]") // list of branch IDs or "ALL"
  storageType     String?      // "Self Storage" / "Business Storage" / "Wine Storage"
  sizeScope       Json         @default("[\"ALL\"]") // list of UnitSize IDs or "ALL"

  // Promo-code-specific fields
  appliesTo           String?   // "First invoice only" / "First 3 invoices" / "Every invoice" / "Selected months"
  usagePerCustomer    Int?
  redemptionCap       Int?
  perUnitApplication  Boolean?
  stackingRule        String?   // "Exclusive" / "Can combine selected" / "Can combine with credits"
  budgetCap           Decimal?  @db.Decimal(12, 2)
  freeMonthCount      Int?      // for FREE_MONTHS kind
  commitmentMonths    Int?      // for FREE_MONTHS kind
  earlyExitTreatment  String?   // "Prorate" / "Clawback" / "Keep"
  minStayPct          Int?      // minimum stay as % of commitment to keep free months

  version         Int        @default(1)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  matrixCells     DiscountMatrixCell[]
  freeMonths      FreeMonthAllocation[]
  rules           PromotionRule[]
  versions        PromotionVersion[]
  promotions      Promotion[]
  redemptions     PromotionRedemption[]

  @@index([kind])
  @@index([status])
  @@index([code])
}

model DiscountMatrixCell {
  id              String   @id @default(cuid())
  planId          String
  plan            PromotionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sizeCategory    String   // XS / S / M / L / XL / XXL
  accessType      String   // "Ground floor" / "Standard"
  commitmentMonths Int     // 3 / 6 / 12
  discountPct     Decimal  @db.Decimal(5, 2)

  @@unique([planId, sizeCategory, accessType, commitmentMonths])
  @@index([planId])
}

model FreeMonthAllocation {
  id              String   @id @default(cuid())
  planId          String
  plan            PromotionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  monthIndex      Int      // 0-based
  free            Boolean  @default(true)
  discountPct     Decimal? @db.Decimal(5, 2)

  @@unique([planId, monthIndex])
  @@index([planId])
}

model PromotionRule {
  id              String   @id @default(cuid())
  planId          String
  plan            PromotionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  groupId         Int      // groups rules into AND/OR clauses
  field           String   // "Facility" / "Size category" / "Customer type" / etc.
  operator        String   // "equals" / "is any of" / "at least" / "is between" / "is not"
  value           String

  @@index([planId])
}

model PromotionVersion {
  id              String   @id @default(cuid())
  planId          String
  plan            PromotionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  version         Int
  snapshot        Json     // full plan state at version time
  changedBy       String
  changeSummary   String
  createdAt       DateTime @default(now())

  @@unique([planId, version])
  @@index([planId])
}

// Links a booking (or a manual operator entry) to the promotion plan that
// discounted it. This is the raw material for the promo-performance panel.
// bookingId is a plain String (NOT a Prisma FK to Booking): bookings predate
// this table and the CMS has no booking-create route yet, so redemptions may
// be recorded manually via POST /promotion-plans/:id/redemptions before any
// booking-time auto-link exists. See core/promotionPlans.ts recordRedemption.
model PromotionRedemption {
  id         String        @id @default(cuid())
  planId     String
  plan       PromotionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  bookingId  String?
  code       String? // promo code entered at booking time (if any)
  amount     Decimal       @db.Decimal(10, 2) // discount value granted (SGD)
  redeemedAt DateTime      @default(now())
  createdAt  DateTime      @default(now())

  @@index([planId])
  @@index([bookingId])
}

model SafeguardRule {
  id                    String   @id @default(cuid())
  facilityId            String?  // FK → Branch (null = global)
  branch                Branch?  @relation(fields: [facilityId], references: [id])
  sizeId                String?  // FK → UnitSize (null = all sizes)
  unitSize              UnitSize? @relation(fields: [sizeId], references: [id])
  minEffectiveRate      Decimal  @db.Decimal(10, 2)
  requiresApprovalAbove Decimal? @db.Decimal(5, 2) // discount % threshold
  approverRole          String?  // who approves

  @@index([facilityId])
  @@index([sizeId])
}

// Whole-app Global Settings (CMS "Global Settings" page, Phase 6).
//
// Deliberately a schemaless key/value store rather than a rigid typed
// singleton: adding a new setting is a row + a `SettingDef` entry in
// src/core/settings.ts — no migration. `key` is the stable identifier
// (e.g. "billing.graceDays"); `value` holds the JSON scalar for that key
// (boolean | number | string — never objects/arrays, enforced in core).
// Reads merge stored rows over the code defaults in `DEFAULT_SETTINGS`,
// so a fresh DB behaves identically to a seeded one.
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
