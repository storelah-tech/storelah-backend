# Server
PORT=4000
NODE_ENV=development

# Postgres
DATABASE_URL="postgresql://storelah:storelah@localhost:5433/storelah?schema=public"

# Isolated backend E2E test database (used ONLY by `pnpm test:e2e` via
# tests/e2e/test-db.ts; the suite refuses to run unless the database name ends
# in `_test`, so the shared dev DB above can never be migrated or truncated).
DATABASE_URL_TEST="postgresql://storelah:storelah@localhost:5433/storelah_test?schema=public"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"

# Default password assigned to auto-provisioned GUEST accounts created by
# unauthenticated booking checkout. Stored bcrypt-hashed at rest; guests keep
# this default until they register or log in with a real credential.
STORELAH_GUEST_DEFAULT_PASSWORD="change-me-guest-default"

# CMS dashboard auto-login credentials
STORELAH_ADMIN_EMAIL="admin@storelah.sg"
STORELAH_ADMIN_PASSWORD="password"

# Stripe Checkout (TEST MODE only — never commit real keys; use test keys
# prefixed sk_test_ / whsec_ from the Stripe dashboard or `stripe listen`).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Base of the booking app used for Checkout redirects, e.g.
# https://app.storelah.sg (locally http://localhost:3001). Success URL is
# {BOOKING_APP_URL}/checkout/success?session_id={CHECKOUT_SESSION_ID};
# cancel URL is {BOOKING_APP_URL}/checkout/cancel.
BOOKING_APP_URL="http://localhost:3001"

# Public lead capture (POST /api/v1/public/leads) — per-IP fixed-window rate
# limit: PUBLIC_LEAD_RATE_LIMIT requests per PUBLIC_LEAD_RATE_WINDOW_MS.
PUBLIC_LEAD_RATE_LIMIT="30"
PUBLIC_LEAD_RATE_WINDOW_MS="60000"

# Host-kind routing — api.storelah.sg serves Swagger UI docs for the customer-
# facing booking API at / and /docs (no auth); cms.storelah.sg (and localhost)
# serves the operator dashboard at / and /admin. The legacy API_HOST_SERVES_UI
# migration flag was retired when the api host stopped serving the dashboard —
# the api host now always serves the docs and 404s the dashboard by design.
