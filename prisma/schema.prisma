// StoreLah — Operator CMS data model.
// Extracted from the original dashboard prototype (storelah-cms/dashboard.html).
// UI constraint: the dashboard layout/CSS is frozen — only data bindings may be added.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  VIEWER
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum UnitStatus {
  OCCUPIED
  AVAILABLE
  RESERVED
  OVERDUE
  MAINTENANCE
  INACTIVE
  // P1: unit is physically held out of inventory (fit-out, damage, audit hold).
  // Not rentable, not browseable, counts toward totals but never toward leased.
  BLOCKED
}

enum TenantStatus {
  ACTIVE
  DUE_SOON
  OVERDUE
  NOTICE
  INACTIVE
}

enum AccountType {
  PERSONAL
  BUSINESS
  // Auto-provisioned during unauthenticated (guest) booking checkout.
  // Guests hold a bcrypt-hashed default password (STORELAH_GUEST_DEFAULT_PASSWORD)
  // until they register or log in with a real credential.
  GUEST
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  ACTIVE
  CANCELLED
}

enum InvoiceStatus {
  PAID
  DUE
  OVERDUE
}

enum LeadStage {
  NEW_ENQUIRY
  CONTACTED
  VIEWING_BOOKED
  PROPOSAL_SENT
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  REFERRAL
  GOOGLE
}

enum AppointmentType {
  VIEWING
  CALLBACK
  VIDEO_CONSULT
  MOVE_IN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  DONE
  CANCELLED
}

enum ConversationChannel {
  WHATSAPP
  EMAIL
  PHONE
  IN_PERSON
  WEBSITE
}

enum MessageDirection {
  IN
  OUT
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(MANAGER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // P1 item 6: facility scoping + verified permissions. Empty rows = legacy
  // role behavior (fallback); enforcement is gated behind these rows.
  facilityAccess OperatorFacilityAccess[]
  permissions    Permission[]
}

model Customer {
  id               String      @id @default(cuid())
  email            String      @unique
  name             String
  mobile           String?
  passwordHash     String
  type             AccountType @default(PERSONAL)
  companyName      String?
  uen              String?
  resetToken       String?     @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Branch {
  id              String       @id @default(cuid())
  code            String       @unique // BM / WD / UB
  name            String
  address         String
  description     String?
  operatingHours  String
  status          BranchStatus @default(ACTIVE)
  floors          Floor[]
  units           Unit[]
  tenants         Tenant[]
  leads           Lead[]
  appointments    Appointment[]
  safeguardRules  SafeguardRule[]
  workOrders      WorkOrder[]
  preventiveTasks PreventiveTask[]
  assets          Asset[]
  incidents       Incident[]
  accessDoors     AccessDoor[]
  accessCredentials AccessCredential[]
  accessEvents    AccessEvent[]
  checklists      InspectionChecklist[]
  certificates    ComplianceCertificate[]
  facilityFees    FacilityFee[]
  operatorAccess  OperatorFacilityAccess[]
  metricsSnapshots FloorplanMetricsSnapshot[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Floor {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  level     Int // 1..4
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units      Unit[]
  floorPlan  FloorPlan? // one-to-one: a floor has exactly one plan (see FloorPlan)
  metricsSnapshots FloorplanMetricsSnapshot[]

  @@unique([branchId, level])
}

// Floor plan for a facility's floor — the editable canvas the operator draws in
// the CMS "facility setup" view.
//
// BLUEPRINT SCALE: 1 grid unit = 1 FOOT. Canvas `width`/`height` are the
// building's real dimensions in feet, and every placement/block rect (x/y/
// width/height) is an integer foot rect in the same space. Columns stay `Int`
// (1 grid unit maps 1:1 to 1 ft — no fractional feet); the editor snaps to the
// grid and renderers scale ft→px at any zoom.
//
// Free-form decoration (walls / corridors / entrance / lift / stairs / fire
// exit) lives in `structure`, plus unit placements.
//
// SINGLE plan per floor, enforced by `@@unique([floorId])`: a floor has one
// physical layout, so consumers can always read THE plan for a floor without
// resolving versions/activation. If draft/versioning is ever needed it can be
// added additively (e.g. a `status` column).
//
// `structure` is a JSONB document rather than relational rows because the
// decorations are presentational and heterogeneously shaped (walls, rooms,
// corridors, entrance, lift, stairs, fire exit each carry different fields),
// are only ever consumed as a whole by the renderer, and are never queried or
// filtered individually. Postgres validates JSON at write time.
//
// Deleting a plan cascades to its placements (UnitPlacement) — see that model —
// and never touches Unit rows.
model FloorPlan {
  id        String   @id @default(cuid())
  floorId   String   @unique
  floor     Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  width     Int      @default(0) // canvas width in FEET (1 grid unit = 1 ft)
  height    Int      @default(0) // canvas height in FEET (1 grid unit = 1 ft)
  structure Json? // LEGACY free-form decorations (walls / corridors / entrance /
                  // lift / stairs / fire exit) from before FloorPlanBlock existed.
                  // Kept readable/writable for old clients; the editor authors new
                  // decorations as FloorPlanBlock rows instead (see FloorPlanBlock).
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  placements UnitPlacement[]
  blocks     FloorPlanBlock[]
  boundaries FloorPlanBoundary[]
}

// Operator-authored layout-decoration rectangles on a plan canvas — e.g. lift,
// stairs, exits, "walking area". A block is a uniform primitive: a NAME label +
// a grid-unit rect (x/y top-left, width/height bounding box, same coordinate
// space as UnitPlacement). It has NO business behaviour — it is purely drawn by
// the renderer. Blocks are the replacement for the old `structure` JSON
// decorations: unlike the heterogeneously-shaped walls/corridors markers, every
// block is the same shape (name + rect), so a flat relational table is clean,
// consistent with UnitPlacement, and each block is addressable/editable/deletable
// on its own (drag, resize, rename) — the JSON polymorphism argument that applied
// to `structure` does not apply here.
//
// Delete semantics: deleting a FloorPlan cascades its blocks (geometry is
// subordinate to the plan).
model FloorPlanBlock {
  id          String    @id @default(cuid())
  floorPlanId String
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  name        String // operator-given label ("Lift", "Stair", "Walking area", "Exit", ...)
  x           Int // top-left FEET coordinate on the plan canvas (1 grid unit = 1 ft)
  y           Int
  width       Int // rendered bounding box in FEET (drag / resize)
  height      Int
  color       String? // optional render tint (hex); renderers default to a neutral tone when null
  // Authored door compass edges (Phase 3: unit/region door side selection).
  // Canonical CSV subset of N/S/E/W in compass order (e.g. "N,S"); NULL means
  // unauthored — the metrics bridge falls back to AUTO_ALL_EDGES for that
  // region. Additive, nullable, no backfill needed.
  doorEdges   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([floorPlanId])
}

// Facility-boundary line items on a plan canvas — the operator-drawn polyline
// loop(s) marking the facility boundary for NLA / GLA / UFA measurement.
//
// One row per drawn line (cf. FloorPlanBlock's one-row-per-rect): a polyline of
// grid-ft vertices (`points` = [[x,y],...] in the same integer-foot space as
// UnitPlacement), an operator label, a kind tag (default BOUNDARY), a `closed`
// flag (true once the loop is closed — only closed loops feed metrics), and a
// `sortOrder` for stable editor ordering.
//
// `points` is JSONB (not relational rows) because vertices are only ever
// consumed as a whole polyline by the renderer/metrics math and are never
// queried or filtered individually — the same presentational-geometry argument
// as the legacy `structure` JSON.
//
// Delete semantics: deleting a FloorPlan cascades its boundaries (geometry is
// subordinate to the plan).
model FloorPlanBoundary {
  id          String    @id @default(cuid())
  floorPlanId String
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  label       String    @default("Boundary") // operator-given line name ("North wing boundary", ...)
  kind        String    @default("BOUNDARY") // line-kind tag (BOUNDARY today; additive for future kinds)
  points      Json // polyline vertices [[x,y],...] in grid-ft units (1 grid unit = 1 ft)
  closed      Boolean   @default(false) // true once the loop is closed — only closed loops feed metrics
  sortOrder   Int       @default(0) // stable editor ordering (lowest first)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([floorPlanId])
}

model UnitSize {
  id        String   @id @default(cuid())
  code      String   @unique // LOCKER / SMALL / MEDIUM / LARGE
  name      String // Locker / Small / Medium / Large
  sqftFrom  Int
  sqftTo    Int
  // Blueprint footprint of a unit of this size, in FEET (1 grid unit = 1 ft).
  // Nullable so a size added without dims falls back to the documented aspect
  // formula in src/core/floorPlans.ts (sqftFootprint); see docs/FLOOR_PLAN_MODEL.md.
  widthFt   Int?
  heightFt  Int?
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units      Unit[]
  promotions Promotion[]
  safeguardRules SafeguardRule[]
  facilityFees FacilityFee[]

  @@map("UnitSize")
}

model Unit {
  id             String     @id @default(cuid())
  branchId       String
  branch         Branch     @relation(fields: [branchId], references: [id])
  floorId        String
  floor          Floor      @relation(fields: [floorId], references: [id])
  sizeId         String
  size           UnitSize   @relation(fields: [sizeId], references: [id])
  unitCode       String     @unique // e.g. BM-01-01
  name           String? // optional display label; null/empty => display name falls back to unitCode
  sqft           Int
  monthlyRate    Decimal    @default(0) @db.Decimal(10, 2)
  status         UnitStatus @default(AVAILABLE)
  climateControl String? // e.g. "Ambient climate"
  deletedAt      DateTime? // soft-delete lifecycle marker: null = active; set = hidden from all reads
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant         Tenant?       @relation("CurrentTenant")
  rateHistory    RateChange[]
  bookings       Booking[]
  invoices       Invoice[]
  notices        Notice[]
  placement      UnitPlacement? // one-to-one: a unit appears on its floor's plan at most once
  workOrders     WorkOrder[]
  incidents      Incident[]

  @@unique([branchId, unitCode])
  @@index([branchId, floorId])
  @@index([status])
}

// Per-unit placement on a floor plan: where (x, y) and how big (width, height) a
// unit is drawn/sized on its floor's plan canvas, in FEET (1 grid unit = 1 ft —
// the rect's area in square grid units ≈ the unit's sqft; see
// docs/FLOOR_PLAN_MODEL.md and sqftFootprint() in src/core/floorPlans.ts).
// Kept as a SEPARATE join model
// rather than geometry columns on Unit so the Unit row stays clean (units predate
// floor plans; geometry is meaningless without a plan) and a soft-deleted unit's
// placement survives deletion (Unit.deletedAt is an UPDATE, not a DELETE).
//
// `@@unique([unitId])` — a unit is placed exactly once: it belongs to one floor,
// and a floor has one plan. The unique key doubles as the upsert key for the
// editor's save. `@@index([floorPlanId])` serves plan-scoped reads.
//
// Delete semantics (respecting the soft-delete lifecycle):
//   - deleting a FloorPlan cascades its placements (geometry is subordinate to the
//     plan; Units are untouched — the FK points from placement to unit, never back);
//   - `onDelete: Restrict` on unit guards against a future HARD unit delete while a
//     placement exists (the purge path must clear placements first; today the app
//     only soft-deletes via `deletedAt`, so Restrict never fires);
//   - reads render a plan by joining placement → unit and FILTERING OUT placements
//     whose unit has `deletedAt != null`, so stale geometry never surfaces.
//
// STACKING (lockers only): two locker placements may share the exact same rect
// (x/y/width/height) as a stacked upper/lower pair, distinguished by `stackTier`
// (0 = ground/sole, 1 = upper). A unit is still placed at most once
// (`@@unique([unitId])`). The overlap guard exempts same-rect pairs whose tiers
// differ; all other overlaps are still rejected. See src/core/floorPlans.ts.
model UnitPlacement {
  id          String    @id @default(cuid())
  floorPlanId String
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  unitId      String    @unique
  unit        Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  x           Int // top-left FEET coordinate on the plan canvas
  y           Int
  width       Int // rendered bounding box in FEET (drag / resize)
  height      Int
  stackTier   Int       @default(0) // stacking tier: 0 = ground/sole tier, 1 = upper tier of a same-rect locker pair
  // Authored door compass edges (Phase 3: unit door side selection, N/S/E/W
  // toggles in the editor). Canonical CSV subset in compass order (e.g.
  // "E,S"); NULL means unauthored — the metrics bridge falls back to
  // AUTO_ALL_EDGES for that unit. Additive, nullable, no backfill needed.
  doorEdges   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([floorPlanId])
}

model Tenant {
  id             String      @id @default(cuid())
  name           String
  type           AccountType @default(PERSONAL)
  segment        String? // E-commerce / Renovation / Downsizing / ...
  email          String?
  mobile         String?
  unitId         String?     @unique
  unit           Unit?       @relation("CurrentTenant", fields: [unitId], references: [id])
  moveInDate     DateTime?
  monthlyRate    Decimal     @db.Decimal(10, 2)
  psf            Decimal     @db.Decimal(10, 2)
  nextPayment    DateTime?
  status         TenantStatus
  lastAccessAt   DateTime?
  accessMethod   String?
  autoDebit      Boolean     @default(false)
  missedPayments Int         @default(0)
  paymentCount   Int         @default(0)
  lifetimeValue  Decimal     @default(0) @db.Decimal(12, 2)
  branchId       String?
  branch         Branch?     @relation(fields: [branchId], references: [id])

  bookings  Booking[]
  invoices  Invoice[]
  notices   Notice[]
  // P1 item 5: per-tenant exception overrides on fees/deposits.
  feeExceptions FacilityFee[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Customer-submitted move-out notice (POST /api/v1/customer/notice). One row
// per submission — resubmitting supersedes (the portal reads the LATEST by
// createdAt); history is preserved for the operator. No workflow state machine
// exists yet: presence of a row == the notice was submitted; TenantStatus.NOTICE
// remains an operator-managed CMS status and is intentionally NOT auto-flipped.
model Notice {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  lastDay   DateTime // the customer-declared final day of tenancy
  createdAt DateTime @default(now()) // submission time
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Booking {
  id             String        @id @default(cuid())
  bookingRef     String        @unique // e.g. SL-2026-0912
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  unitId         String
  unit           Unit          @relation(fields: [unitId], references: [id])
  moveInDate     DateTime
  duration       String // "Monthly" | "3 months" | ...
  amount         Decimal       @db.Decimal(10, 2)
  status         BookingStatus @default(PENDING_PAYMENT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Invoice {
  id         String        @id @default(cuid())
  invoiceNo  String        @unique // e.g. INV-2026-0847
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  unitId     String
  unit       Unit          @relation(fields: [unitId], references: [id])
  amount     Decimal       @db.Decimal(10, 2)
  dueDate    DateTime
  status     InvoiceStatus @default(DUE)
  method     String? // Auto-debit / Card / Manual
  billedMonth DateTime @default(now())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
}

model Lead {
  id            String     @id @default(cuid())
  name          String
  type          AccountType @default(PERSONAL)
  segment       String? // Reno / Home / SME / Expat
  stage         LeadStage  @default(NEW_ENQUIRY)
  source        LeadSource @default(WEBSITE)
  preferredSize String?
  preferredBranchId String?
  branch        Branch?    @relation(fields: [preferredBranchId], references: [id])
  monthlyRate   Decimal?   @db.Decimal(10, 2)
  note          String?
  email         String?
  mobile        String?
  owner         String? // operator handling this lead (shown as "owner" in the lead database)
  nextActionAt  DateTime? // next follow-up ("next step" column in the lead database)
  // Loss attribution for the analytics page: set when a lead moves to LOST.
  // lossReason defaults to "Unspecified" so pre-existing flows keep working;
  // lossValue defaults to the lead's monthlyRate at loss time (revenue proxy).
  lossReason    String?
  lossValue     Decimal?  @db.Decimal(10, 2)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  appointments Appointment[]
  conversations Conversation[]
}

model Appointment {
  id         String            @id @default(cuid())
  title      String
  personName String
  type       AppointmentType
  branchId   String?
  branch     Branch?           @relation(fields: [branchId], references: [id])
  leadId     String?
  lead       Lead?             @relation(fields: [leadId], references: [id])
  startAt    DateTime
  endAt      DateTime?
  status     AppointmentStatus @default(PENDING)
  note       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([startAt])
  @@index([branchId])
  @@index([leadId])
}

// Operator inbox threads. One lead may have several conversations (e.g. a
// WhatsApp thread plus an email thread); `externalId` holds the provider-side
// thread id when one exists. Real WhatsApp/email SENDING is out of scope —
// outbound rows are recorded by the send stub in src/core/conversations.ts.
model Conversation {
  id         String              @id @default(cuid())
  leadId     String
  lead       Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel    ConversationChannel @default(WHATSAPP)
  externalId String?
  assignee   String? // operator owner of this thread (inbox "Assign")
  status     String              @default("OPEN") // OPEN | CLOSED
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  messages Message[]
  notes    ConversationNote[]

  @@index([leadId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection @default(IN)
  sender         String? // display name of the author (lead name / operator)
  body           String
  sentAt         DateTime         @default(now())
  createdAt      DateTime         @default(now())

  @@index([conversationId])
}

// Internal operator notes on a thread (inbox composer "Add a note") — never
// sent anywhere, only shown in the timeline.
model ConversationNote {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  body           String
  author         String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model RateChange {
  id         String   @id @default(cuid())
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id])
  date       DateTime
  previous   Decimal  @db.Decimal(10, 2)
  current    Decimal  @db.Decimal(10, 2)
  changePct  Decimal  @db.Decimal(6, 2)
  reason     String
  appliedBy  String // name or "System"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([unitId])
}

enum PromotionDiscountType {
  PERCENTAGE
  FLAT
}

enum PromotionBenefitType {
  PERCENTAGE
  DOLLAR
  FREE_MONTHS
  CREDITS
}

enum PlanKind {
  DISCOUNT_MATRIX
  FREE_MONTHS
  PROMO_CODE
  CREDITS
}

enum PlanStatus {
  DRAFT
  VALIDATED
  SCHEDULED
  ACTIVE
  ENDED
}

enum PromoStatus {
  DRAFT
  ACTIVE
  SCHEDULED
  ENDED
  USED
}

model Promotion {
  id             String                 @id @default(cuid())
  code           String                 @unique // e.g. STORELAH10
  name           String
  description    String?
  discountType   PromotionDiscountType  @default(PERCENTAGE)
  discountValue  Decimal                @db.Decimal(10, 2)
  minMonths      Int?
  applicableSizeId String?
  applicableSize UnitSize?              @relation(fields: [applicableSizeId], references: [id])
  startDate      DateTime?
  endDate        DateTime?
  active         Boolean                @default(true)

  // Enhanced fields (additive — backward compatible)
  planId         String?                // FK → PromotionPlan (nullable for backward compat)
  plan           PromotionPlan?         @relation(fields: [planId], references: [id])
  status         PromoStatus?           @default(DRAFT)
  benefitType    PromotionBenefitType?
  applyTo        String?                // "First invoice only" / "First 3 invoices" / "Every invoice" / "Selected months"
  usagePerCustomer Int?
  redemptionCap  Int?
  perUnitApplication Boolean?
  stackingRule   String?                // "Cannot combine" / "Can combine selected" / "Can combine with credits"
  budgetCap      Decimal?               @db.Decimal(12, 2)

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([active])
  @@index([planId])
}

model PromotionPlan {
  id              String       @id @default(cuid())
  kind            PlanKind
  name            String
  code            String?      @unique // customer-facing code (only for PROMO_CODE kind)
  status          PlanStatus   @default(DRAFT)
  description     String?
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  facilityScope   Json         @default("[\"ALL\"]") // list of branch IDs or "ALL"
  storageType     String?      // "Self Storage" / "Business Storage" / "Wine Storage"
  sizeScope       Json         @default("[\"ALL\"]") // list of UnitSize IDs or "ALL"

  // Promo-code-specific fields
  appliesTo           String?   // "First invoice only" / "First 3 invoices" / "Every invoice" / "Selected months"
  usagePerCustomer    Int?
  redemptionCap       Int?
  perUnitApplication  Boolean?
  stackingRule        String?   // "Exclusive" / "Can combine selected" / "Can combine with credits"
  budgetCap           Decimal?  @db.Decimal(12, 2)
  freeMonthCount      Int?      // for FREE_MONTHS kind
  commitmentMonths    Int?      // for FREE_MONTHS kind
  earlyExitTreatment  String?   // "Prorate" / "Clawback" / "Keep"
  minStayPct          Int?      // minimum stay as % of commitment to keep free months

  version         Int        @default(1)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  matrixCells     DiscountMatrixCell[]
  freeMonths      FreeMonthAllocation[]
  rules           PromotionRule[]
  versions        PromotionVersion[]
  promotions      Promotion[]
  redemptions     PromotionRedemption[]

  @@index([kind])
  @@index([status])
  @@index([code])
}

model DiscountMatrixCell {
  id              String   @id @default(cuid())
  planId          String
  plan            PromotionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sizeCategory    String   // LOCKER / SMALL / MEDIUM / LARGE / XL / XXL (canonical; legacy XS reads as LOCKER)
  accessType      String   // "Ground floor" / "Standard"
  commitmentMonths Int     // 1 / 3 / 6 / 12
  discountPct     Decimal  @db.Decimal(5, 2)

  @@unique([planId, sizeCategory, accessType, commitmentMonths])
  @@index([planId])
}

model FreeMonthAllocation {
  id              String   @id @default(cuid())
  planId          String
  plan            PromotionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  monthIndex      Int      // 0-based
  free            Boolean  @default(true)
  discountPct     Decimal? @db.Decimal(5, 2)

  @@unique([planId, monthIndex])
  @@index([planId])
}

model PromotionRule {
  id              String   @id @default(cuid())
  planId          String
  plan            PromotionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  groupId         Int      // groups rules into AND/OR clauses
  field           String   // "Facility" / "Size category" / "Customer type" / etc.
  operator        String   // "equals" / "is any of" / "at least" / "is between" / "is not"
  value           String

  @@index([planId])
}

model PromotionVersion {
  id              String   @id @default(cuid())
  planId          String
  plan            PromotionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  version         Int
  snapshot        Json     // full plan state at version time
  changedBy       String
  changeSummary   String
  createdAt       DateTime @default(now())

  @@unique([planId, version])
  @@index([planId])
}

// Links a booking (or a manual operator entry) to the promotion plan that
// discounted it. This is the raw material for the promo-performance panel.
// bookingId is a plain String (NOT a Prisma FK to Booking): bookings predate
// this table and the CMS has no booking-create route yet, so redemptions may
// be recorded manually via POST /promotion-plans/:id/redemptions before any
// booking-time auto-link exists. See core/promotionPlans.ts recordRedemption.
model PromotionRedemption {
  id         String        @id @default(cuid())
  planId     String
  plan       PromotionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  bookingId  String?
  code       String? // promo code entered at booking time (if any)
  amount     Decimal       @db.Decimal(10, 2) // discount value granted (SGD)
  redeemedAt DateTime      @default(now())
  createdAt  DateTime      @default(now())

  @@index([planId])
  @@index([bookingId])
}

model SafeguardRule {
  id                    String   @id @default(cuid())
  facilityId            String?  // FK → Branch (null = global)
  branch                Branch?  @relation(fields: [facilityId], references: [id])
  sizeId                String?  // FK → UnitSize (null = all sizes)
  unitSize              UnitSize? @relation(fields: [sizeId], references: [id])
  minEffectiveRate      Decimal  @db.Decimal(10, 2)
  requiresApprovalAbove Decimal? @db.Decimal(5, 2) // discount % threshold
  approverRole          String?  // who approves

  @@index([facilityId])
  @@index([sizeId])
}

// Whole-app Global Settings (CMS "Global Settings" page, Phase 6).
//
// Deliberately a schemaless key/value store rather than a rigid typed
// singleton: adding a new setting is a row + a `SettingDef` entry in
// src/core/settings.ts — no migration. `key` is the stable identifier
// (e.g. "billing.graceDays"); `value` holds the JSON scalar for that key
// (boolean | number | string — never objects/arrays, enforced in core).
// Reads merge stored rows over the code defaults in `DEFAULT_SETTINGS`,
// so a fresh DB behaves identically to a seeded one.
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Facility operations (CMS "Facilities Management" sidebar modules 2–6).
// Additive only: brand-new tables, no changes to existing models beyond the
// back-relation arrays on Branch/Unit above.
// ---------------------------------------------------------------------------

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum PreventiveCategory {
  HVAC
  FIRE
  DOORS
  CCTV
}

enum AssetStatus {
  ACTIVE
  IN_SERVICE
  RETIRED
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AccessEventResult {
  GRANTED
  DENIED
}

enum CredentialType {
  PERMANENT
  TEMPORARY
  VISITOR
}

enum CredentialStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum DoorStatus {
  ACTIVE
  INACTIVE
}

enum InspectionFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum ChecklistStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum CertificateStatus {
  VALID
  EXPIRING
  EXPIRED
}

// Maintenance work order: branch/unit scope, OPEN → IN_PROGRESS → DONE
// lifecycle, monetary value of the job.
model WorkOrder {
  id          String          @id @default(cuid())
  title       String
  description String?
  branchId    String?
  branch      Branch?         @relation(fields: [branchId], references: [id])
  unitId      String?
  unit        Unit?           @relation(fields: [unitId], references: [id])
  status      WorkOrderStatus @default(OPEN)
  priority    String? // Low / Medium / High
  value       Decimal         @default(0) @db.Decimal(10, 2)
  assignee    String?
  dueDate     DateTime?
  completedAt DateTime? // set when the order transitions to DONE
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([branchId])
  @@index([status])
}

// Preventive-maintenance checklist task, grouped by trade category
// (HVAC / Fire / Doors / CCTV) with a % complete per task.
model PreventiveTask {
  id              String             @id @default(cuid())
  title           String
  category        PreventiveCategory
  branchId        String?
  branch          Branch?            @relation(fields: [branchId], references: [id])
  percentComplete Int                @default(0)
  dueDate         DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([branchId])
  @@index([category])
}

// Asset register row: stable operator code (e.g. AST-WDL-HVAC-04) + branch link.
model Asset {
  id           String      @id @default(cuid())
  code         String      @unique // e.g. AST-WDL-HVAC-04
  name         String
  category     String // HVAC / Fire / Doors / CCTV / ...
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id])
  status       AssetStatus @default(ACTIVE)
  purchaseDate DateTime?
  value        Decimal?    @db.Decimal(10, 2)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([branchId])
  @@index([status])
}

// Vendor register row: SLA commitment + year-to-date spend.
model Vendor {
  id        String       @id @default(cuid())
  name      String
  service   String? // e.g. "HVAC servicing"
  sla       String? // e.g. "4h response"
  ytdSpend  Decimal      @default(0) @db.Decimal(12, 2)
  status    VendorStatus @default(ACTIVE)
  contact   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
}

// Operational incident: severity, lifecycle status, branch/unit link and a
// multi-step resolution checklist stored as JSON
// ([{ label, done }, ...] — presentational, never queried individually).
model Incident {
  id          String           @id @default(cuid())
  title       String
  description String?
  severity    IncidentSeverity @default(MEDIUM)
  status      IncidentStatus   @default(OPEN)
  branchId    String?
  branch      Branch?          @relation(fields: [branchId], references: [id])
  unitId      String?
  unit        Unit?            @relation(fields: [unitId], references: [id])
  checklist   Json? // multi-step resolution checklist
  reportedBy  String?
  resolvedAt  DateTime? // set when the incident transitions to RESOLVED/CLOSED
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([branchId])
  @@index([severity])
  @@index([status])
}

// Access-control door (one row per controlled entry point).
model AccessDoor {
  id        String     @id @default(cuid())
  code      String     @unique // e.g. WDL-GATE-01
  name      String
  branchId  String?
  branch    Branch?    @relation(fields: [branchId], references: [id])
  location  String?
  status    DoorStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  events AccessEvent[]

  @@index([branchId])
}

// Access credential (fob / card / PIN holder). TEMPORARY/VISITOR rows carry a
// validTo expiry and back the "Temporary" sub-panel.
model AccessCredential {
  id         String           @id @default(cuid())
  holderName String
  type       CredentialType   @default(PERMANENT)
  status     CredentialStatus @default(ACTIVE)
  branchId   String?
  branch     Branch?          @relation(fields: [branchId], references: [id])
  validFrom  DateTime?
  validTo    DateTime? // expiry for TEMPORARY / VISITOR credentials
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  events AccessEvent[]

  @@index([branchId])
  @@index([status])
}

// Access policy (named rule set, e.g. "Contractor hours").
model AccessPolicy {
  id          String   @id @default(cuid())
  name        String
  description String?
  scope       String? // e.g. "WD · all doors"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Access event (entry log). result DENIED rows back the "Exceptions"
// sub-panel; the "Live" sub-panel reads the most recent rows.
model AccessEvent {
  id           String            @id @default(cuid())
  doorId       String?
  door         AccessDoor?       @relation(fields: [doorId], references: [id])
  credentialId String?
  credential   AccessCredential? @relation(fields: [credentialId], references: [id])
  branchId     String?
  branch       Branch?           @relation(fields: [branchId], references: [id])
  result       AccessEventResult @default(GRANTED)
  occurredAt   DateTime          @default(now())
  note         String?
  createdAt    DateTime          @default(now())

  @@index([branchId])
  @@index([doorId])
  @@index([occurredAt])
}

// Recurring inspection checklist (daily / monthly / ...). items is a JSON
// step list ([{ label, done }, ...]); percentComplete is operator-maintained.
model InspectionChecklist {
  id              String              @id @default(cuid())
  title           String
  frequency       InspectionFrequency @default(DAILY)
  branchId        String?
  branch          Branch?             @relation(fields: [branchId], references: [id])
  items           Json? // checklist steps
  percentComplete Int                 @default(0)
  status          ChecklistStatus     @default(OPEN)
  dueDate         DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([branchId])
  @@index([frequency])
}

// Compliance certificate (Fire Safety / Lift / Public Liability / ...) with
// an expiry date. Expiry surfacing reads expiryDate (plus the status mirror).
model ComplianceCertificate {
  id         String            @id @default(cuid())
  name       String
  type       String // e.g. "Fire Safety" / "Lift" / "Public Liability"
  branchId   String?
  branch     Branch?           @relation(fields: [branchId], references: [id])
  issuer     String?
  expiryDate DateTime
  status     CertificateStatus @default(VALID)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([branchId])
  @@index([expiryDate])
}

// ---------------------------------------------------------------------------
// P1 facility extensions (additive): fees/deposits with per-facility override,
// business rules, operator facility scoping + permissions.
// ---------------------------------------------------------------------------

enum FeeScope {
  GLOBAL
  FACILITY
  PRODUCT
  EXCEPTION
}

enum FeeKind {
  FEE
  DEPOSIT
}

// Fee / deposit rule with a Global → Facility → Product → Exception priority
// chain. The scalar Setting store cannot hold this shape (a fee needs a key +
// a scope + an optional branch/size/tenant target), so it is relational.
// Resolution order (see resolveFee in src/core/fees.ts): the most specific
// ACTIVE row matching (kind, key) wins — EXCEPTION (tenantId) > PRODUCT
// (sizeId) > FACILITY (branchId) > GLOBAL (no target). amountKind is FLAT
// (SGD), PCT (% of monthly rate) or MONTHS (multiples of monthly rate,
// deposits only).
model FacilityFee {
  id         String   @id @default(cuid())
  kind       FeeKind  @default(FEE)
  key        String // e.g. "lateFee" / "adminFee" / "deposit" / "insurance"
  scope      FeeScope @default(GLOBAL)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id])
  sizeId     String?
  unitSize   UnitSize? @relation(fields: [sizeId], references: [id])
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(10, 2)
  amountKind String   @default("FLAT") // FLAT | PCT | MONTHS
  active     Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([kind, key, active])
  @@index([branchId])
  @@index([sizeId])
  @@index([tenantId])
}

// Org + booking business rules beyond the scalar booking settings
// (booking.autoConfirm / minAdvanceHours / maxStayMonths). Typed key/value
// rows (see DEFAULT_BUSINESS_RULES in src/core/businessRules.ts): reads merge
// stored rows over code defaults so a fresh DB behaves like a seeded one;
// writes validate against the def (boolean | number | text).
model BusinessRule {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "booking.moveOutNoticeDays"
  category    String // "org" | "booking" | ...
  value       Json
  active      Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// P1 item 6: which facilities an operator may act on. One row per
// (admin, branch); scope "ALL" with branchId NULL grants every facility.
// An operator with NO rows is unscoped (legacy behavior — full access).
model OperatorFacilityAccess {
  id          String   @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  scope       String   @default("FACILITY") // FACILITY | ALL
  createdAt   DateTime @default(now())

  @@unique([adminUserId, branchId])
  @@index([adminUserId])
}

// Floor-plan area-metrics snapshots (Phase 2: Floor Plan Area Metrics).
//
// APPEND-ONLY history of published metric reports, one row per POST
// /api/v1/cms/floor-plans/:floorId/metrics/snapshots. There is deliberately
// NO unique constraint on (floor, effective_date): publishing the same date
// twice creates two rows (history, not state). There is no PUT/PATCH route.
// Rows whose geometry failed validation are never persisted (the service
// throws 422 before writing). payload is the full live report at publish
// time (areas as exact decimal-string Q + sqft floats; money as integer
// cents + 2dp SGD — JSON-safe, no BigInt). The lookup key for history reads
// is (branchId, floorId, effectiveDate); schemaVersion tags the payload shape
// (see METRICS_SCHEMA_VERSION in src/core/floorPlanMetrics.ts).
model FloorplanMetricsSnapshot {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floorId       String
  floor         Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  effectiveDate DateTime // UTC midnight of the operator-supplied YYYY-MM-DD effective_date
  schemaVersion Int      @default(1)
  geometryHash  String // SHA-256 over the canonicalised sorted region set
  payload       Json // full FloorMetricsReport at publish time
  createdAt     DateTime @default(now())

  @@index([branchId, floorId, effectiveDate])
  @@index([floorId])
}

// P1 item 6: verified permission grants (replaces free-text approverRole ONLY
// where gated — see mayAct in src/core/users.ts). Catalog: promotions.approve,
// fees.manage, businessRules.manage, users.manage. An operator with NO
// permission rows is unchecked (legacy fallback); enforcement applies only to
// operators that have at least one row.
model Permission {
  id          String   @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  permission  String
  createdAt   DateTime @default(now())

  @@unique([adminUserId, permission])
  @@index([adminUserId])
}
