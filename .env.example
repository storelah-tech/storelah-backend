# Server
PORT=4000
NODE_ENV=development

# Postgres
DATABASE_URL="postgresql://storelah:storelah@localhost:5433/storelah?schema=public"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"

# CMS dashboard auto-login credentials
STORELAH_ADMIN_EMAIL="admin@storelah.sg"
STORELAH_ADMIN_PASSWORD="password"

# Host-kind routing — cms.storelah.sg migration gate (2026-08)
# While this is truthy (migration state), the api.storelah.sg host keeps serving
# the CMS UI at /admin and / exactly as today. After the cutover to
# cms.storelah.sg, set it to 0 or false so the api host 404s the UI (API routes
# under /api/v1/cms and /api/cms are never affected). The CMS host always serves
# its dashboard regardless of this flag.
API_HOST_SERVES_UI=1
