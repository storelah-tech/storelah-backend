# Server
PORT=4000
NODE_ENV=development

# Postgres
DATABASE_URL="postgresql://storelah:storelah@localhost:5433/storelah?schema=public"

# Isolated backend E2E test database (used ONLY by `pnpm test:e2e` via
# tests/e2e/test-db.ts; the suite refuses to run unless the database name ends
# in `_test`, so the shared dev DB above can never be migrated or truncated).
DATABASE_URL_TEST="postgresql://storelah:storelah@localhost:5433/storelah_test?schema=public"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"

# Default password assigned to auto-provisioned GUEST accounts created by
# unauthenticated booking checkout. Stored bcrypt-hashed at rest; guests keep
# this default until they register or log in with a real credential.
STORELAH_GUEST_DEFAULT_PASSWORD="change-me-guest-default"

# CMS dashboard auto-login credentials
STORELAH_ADMIN_EMAIL="admin@storelah.sg"
STORELAH_ADMIN_PASSWORD="password"

# Stripe Checkout (TEST MODE only — never commit real keys; use test keys
# prefixed sk_test_ / whsec_ from the Stripe dashboard or `stripe listen`).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Base of the booking app baked into Stripe Checkout success_url/cancel_url.
# Success URL is {BOOKING_APP_URL}/checkout/success?session_id={CHECKOUT_SESSION_ID};
# cancel URL is {BOOKING_APP_URL}/checkout/cancel.
# PRODUCTION REQUIREMENT: must be the public https booking origin —
# https://app.storelah.sg (canonical; renamed from booking.storelah.sg).
# A localhost value with NODE_ENV=production breaks post-payment redirects
# (mobile browsers can never reach the server's localhost) — the backend logs
# a loud startup warning in that case. The localhost value below is the local
# dev default only.
BOOKING_APP_URL="http://localhost:3001"

# AWS SES booking + payment confirmation email (POST /customer/stripe/webhook
# sends best-effort after checkout.session.completed applies). Empty = email
# skipped with a log line; the payment itself always succeeds regardless.
# No NODE_ENV special-casing needed in config: the sender skips the network
# outright when NODE_ENV=test so hermetic e2e suites never touch SES.
# The From address (or its domain) must be a verified SES identity, and the
# Lambda execution role needs ses:SendRawEmail (ses:SendEmail optional /
# back-compat) — both are AWS-side prerequisites outside this repo. SES starts
# in sandbox mode (verified recipients only); request production access to
# email real customers.
# Configuration-set gotcha: this backend never sends a ConfigurationSetName
# (no SES_CONFIGURATION_SET var exists by design). If SES still denies a send
# on a "configuration-set/<name>" resource, that set is the sender identity's
# DEFAULT configuration set (set on the verified SES identity in the console —
# not in code). Fix AWS-side: either grant the execution role ses:SendRawEmail
# on that configuration-set resource, or clear the default configuration set
# on the identity. Either way no code change is needed.
# Auth: prod uses the Lambda execution role (no keys — default credential
# chain); local dev can set explicit AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# (optionally AWS_SESSION_TOKEN) alongside AWS_SES_REGION.
# SES_FROM_EMAIL is the only required var; the region defaults to the Lambda
# deploy region ap-southeast-1.
SES_FROM_EMAIL=""
SES_FROM_NAME="StoreLah"
AWS_SES_REGION="ap-southeast-1"
# Local-dev only (prod uses the Lambda execution role — leave these unset):
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Public lead capture (POST /api/v1/public/leads) — per-IP fixed-window rate
# limit: PUBLIC_LEAD_RATE_LIMIT requests per PUBLIC_LEAD_RATE_WINDOW_MS.
PUBLIC_LEAD_RATE_LIMIT="30"
PUBLIC_LEAD_RATE_WINDOW_MS="60000"

# Landing content management (CMS /content + public /content image uploads).
# CONTENT_S3_BUCKET unset = local fallback (files under CONTENT_LOCAL_DIR,
# served at /uploads/content). Set the bucket to use S3 (direct server-side
# PutObject; auth via the default AWS credential chain — Lambda execution
# role in prod, explicit AWS_* keys for local dev only). Bucket creation +
# public-read policy are devops-owned (see docs/CONTENT_MANAGEMENT.md).
# CONTENT_S3_BUCKET=""
CONTENT_S3_REGION="ap-southeast-1"
# CONTENT_S3_PUBLIC_BASE_URL="https://<bucket>.s3.ap-southeast-1.amazonaws.com"
# CONTENT_S3_PREFIX="content"
# CONTENT_LOCAL_DIR="./uploads/content"
# CONTENT_IMAGE_MAX_BYTES="8388608"

# Host-kind routing — api.storelah.sg serves Swagger UI docs for the customer-
# facing booking API at / and /docs (no auth); cms.storelah.sg (and localhost)
# serves the operator dashboard at / and /admin. The legacy API_HOST_SERVES_UI
# migration flag was retired when the api host stopped serving the dashboard —
# the api host now always serves the docs and 404s the dashboard by design.
